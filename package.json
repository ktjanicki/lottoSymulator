{
  "name": "lotto-symulator",
  "version": "1.8.2",
  "private": true,
  "description": "Lotto draw simulator",
  "author": "Krzysztof Janicki",
  "license": "Apache-2.0",
  "scripts": {
    "start": "parcel index.html",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check:prod": "BASE_URL=https://lottosymulator.grossnet.pl playwright test --grep @prod"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "parcel": "2.16.4",
    "prettier": "3.9.9"
  }
}
